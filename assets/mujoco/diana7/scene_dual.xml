<mujoco model="scene">
    <compiler angle="radian" autolimits="true" />
    <option timestep="0.002" integrator="implicitfast" solver="PGS" gravity="0 0 -9.82"
            cone="elliptic">
        <!-- <flag multiccd="enable"/> -->
    </option>

    <!-- 合并默认类 -->
    <default>
        <default class="L_diana">
            <material specular="0.5" shininess="0.25"/>
            <joint axis="0 0 1"/>
            <general gaintype="fixed" biastype="affine" ctrlrange="-6.2831 6.2831" 
                    gainprm="2000" biasprm="0 -2000 -400" forcerange="-150 150" />
            <default class="L_joint_1">
                <joint range="-3.12 3.12"/>
                <general ctrlrange="-3.1415 3.1415"/>
            </default>
            <default class="L_joint_2">
                <joint range="-2.0944 2.0944"/>
                <general ctrlrange="-2.0944 2.0944"/>
            </default>
            <default class="L_joint_3">
                <joint range="-3.05433 3.05433"/>
                <general ctrlrange="-3.05433 3.05433"/>
            </default>
        </default>

        <default class="R_diana">
            <material specular="0.5" shininess="0.25"/>
            <joint axis="0 0 1"/>
            <general gaintype="fixed" biastype="affine" ctrlrange="-6.2831 6.2831" 
                    gainprm="2000" biasprm="0 -2000 -400" forcerange="-150 150" />
            <default class="R_joint_1">
                <joint range="-3.12 3.12"/>
                <general ctrlrange="-3.1415 3.1415"/>
            </default>
            <default class="R_joint_2">
                <joint range="-2.0944 2.0944"/>
                <general ctrlrange="-2.0944 2.0944"/>
            </default>
            <default class="R_joint_3">
                <joint range="-3.05433 3.05433"/>
                <general ctrlrange="-3.05433 3.05433"/>
            </default>
        </default>

        <default class="size1">
            <general gainprm="400" biasprm="0 -500 -100" forcerange="-28 28" />
        </default>
        <default class="visual">
            <geom type="mesh" contype="0" conaffinity="0" group="2" material="white"/>
        </default>
        <default class="collision">
            <geom type="cylinder" />
        </default>
    </default>

    <!-- 合并资产 -->
    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" 
                 width="512" height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" 
                 rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" 
                 width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" 
                 texrepeat="5 5" reflectance="0.2" />
        <mesh name="table" file="../table/sigmund_table.stl" scale="1 1 1"/>
        <mesh name="body_mesh" file="body.obj"/>
        <material name="human_body_material" rgba="0.8 0.6 0.4 1"/>

        <!-- L_diana资源 -->
        <mesh name="L_diana_base" file="base.obj"/>
        <mesh name="L_link_1" file="link_1.obj"/>
        <mesh name="L_link_2" file="link_2.obj"/>
        <mesh name="L_link_3" file="link_3.obj"/>
        <mesh name="L_link_4" file="link_4.obj"/>
        <mesh name="L_link_5" file="link_5.obj"/>
        <mesh name="L_link_6" file="link_6.obj"/>
        <mesh name="L_link_7" file="link_7.obj"/>

        <!-- R_diana资源 -->
        <mesh name="R_diana_base" file="base.obj"/>
        <mesh name="R_link_1" file="link_1.obj"/>
        <mesh name="R_link_2" file="link_2.obj"/>
        <mesh name="R_link_3" file="link_3.obj"/>
        <mesh name="R_link_4" file="link_4.obj"/>
        <mesh name="R_link_5" file="link_5.obj"/>
        <mesh name="R_link_6" file="link_6.obj"/>
        <mesh name="R_link_7" file="link_7.obj"/>
    </asset>

    <worldbody>
        <!-- 原有场景元素保持不变 -->
         <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
		<geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />
		<geom name="x-aixs" group="2" type="cylinder" contype="0" conaffinity="0"
			fromto="0 0 0 1 0 0" size="0.01" rgba="1 0 0 1" />
		<geom name="y-aixs" group="2" type="cylinder" contype="0" conaffinity="0"
			fromto="0 0 0 0 1 0" size="0.01" rgba="0 1 0 1" />
